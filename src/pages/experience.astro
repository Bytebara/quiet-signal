---
import Base from '../layouts/Base.astro';
import { roles } from '../data/experience';
---

<Base title="Experience" description="Professional experience in technical support and customer-facing roles.">
  <p class="path">cat ~/experience</p>
  <h1>Experience</h1>
  <p class="lead">
    No professional security role yet. What I bring from support and customer work is troubleshooting, careful
    documentation and staying clear under a queue.
  </p>

  <ol class="roles">
    {
      roles.map((r) => (
        <li>
          <div class="top">
            <h2>{r.title}</h2>
            <p class="when">{r.years}</p>
          </div>
          <p class="org">{r.org}</p>
          <p>{r.summary}</p>
          <ul>
            {r.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          <p class="carry">
            <span>Why it carries over: </span>
            {r.carriesOver}
          </p>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .roles {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    max-width: var(--measure);
  }
  .roles > li {
    border-left: 2px solid var(--rule);
    padding: 0 0 2rem 1.25rem;
    position: relative;
  }
  .roles > li:first-child {
    border-left-color: var(--signal-dim);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1rem;
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .when {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  .org {
    color: var(--signal);
    margin: 0.15rem 0 0.6rem;
  }
  ul {
    padding-left: 1.2rem;
  }
  .carry {
    font-size: 0.95rem;
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
  }
  .carry span {
    font-weight: 600;
  }
</style>
