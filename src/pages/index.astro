---
import Base from '../layouts/Base.astro';
import EvidenceTag from '../components/EvidenceTag.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../config/site';
import { evidenceLevels, type Evidence } from '../lib/evidence';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.status !== 'planned').slice(0, 3);
const next = projects.filter((p) => p.data.status === 'planned');
const legend: Evidence[] = ['applied', 'explored', 'learning', 'simulated', 'planned'];
---

<Base>
  <section class="hero">
    <p class="path">whoami</p>
    <h1>Working toward cloud security engineering, with the evidence labeled.</h1>
    <div class="prose">
      <p class="lead">
        I’m working toward becoming a cloud security engineer: the person who designs cloud environments so they’re
        secure from the start, and who catches it fast when something goes wrong.
      </p>
      <p>
        My foundation is front-line technical support. I diagnose faults under time pressure, document every device
        that comes through intake, and explain fixes clearly to people who aren’t technical. That’s where I learned that
        security problems are usually operations problems: a missed patch, a misconfiguration, an account with more
        access than it needs.
      </p>
      <p>
        Now I’m building the skills to solve those problems at cloud scale. I run a self-hosted security lab at home: a
        hardened Raspberry Pi with key-only SSH, a host firewall, intrusion prevention, DNS filtering and VPN access,
        which serves this site through an encrypted tunnel and sends its logs to Splunk, where I search and hunt. Next
        in the lab are network segmentation and containerized services. From there I’m moving into AWS, focusing on
        identity and access management, secure network design, cloud logging and threat detection, and infrastructure
        as code.
      </p>
      <p>
        I want to work where security operations meets cloud engineering: monitoring and responding to threats,
        automating the repetitive first steps of triage, and building guardrails so the same incident doesn’t happen
        twice. I document everything I build, break and fix in my lab, and you can follow along on
        <a href="https://github.com/Bytebara">GitHub</a>.
      </p>
    </div>
  </section>

  <section class="legend" aria-labelledby="legend-h">
    <h2 id="legend-h">How to read this site</h2>
    <p class="muted prose">
      Every skill, project and write-up carries one label, so you can see at a glance what’s been used for real and
      what’s still in progress.
    </p>
    <dl>
      {
        legend.map((level) => (
          <div>
            <dt>
              <EvidenceTag level={level} />
            </dt>
            <dd>{evidenceLevels[level].meaning}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="work-h">
    <h2 id="work-h">Work to look at first</h2>
    <ul class="featured">
      {
        featured.map((p) => (
          <li>
            <div class="row">
              <h3>
                <a href={withBase(`/projects/${p.id}/`)}>{p.data.title}</a>
              </h3>
              <EvidenceTag level={p.data.status} />
            </div>
            <p>{p.data.summary}</p>
            {p.data.demo && (
              <p>
                <a href={withBase(p.data.demo)}>Open the live demo</a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="next-h">
    <h2 id="next-h">Building next</h2>
    <ul class="next">
      {
        next.map((p) => (
          <li>
            <a href={withBase(`/projects/${p.id}/`)}>{p.data.title}</a>
            <span class="muted">{p.data.summary}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding: 1.5rem 0 1rem;
  }
  .hero h1 {
    max-width: 22ch;
    margin-bottom: 1.25rem;
  }
  .legend dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 1rem 0 0;
  }
  .legend dl > div {
    border-top: 1px solid var(--rule);
    padding-top: 0.75rem;
  }
  .legend dd {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.925rem;
  }
  .featured {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
  .featured li {
    border-top: 2px solid var(--signal-dim);
    padding-top: 1rem;
  }
  .featured .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: baseline;
  }
  .featured h3 {
    margin: 0;
  }
  .featured h3 a {
    color: var(--text);
  }
  .featured p {
    margin: 0.5rem 0 0;
  }
  .next {
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }
  .next li {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
</style>
