---
// Alert triage decision flow used in the SOC lab demo.
const steps = [
  { x: 10, title: 'Alert fires', sub: 'rule + raw event' },
  { x: 180, title: 'Plausible?', sub: 'normal for host/user' },
  { x: 350, title: 'Map technique', sub: 'MITRE ATT&CK' },
  { x: 520, title: 'Disposition', sub: 'decide and record why' },
];
const W = 150;
const Y = 90;
const H = 66;
---

<figure class="diagram">
  <div class="scroll">
    <svg viewBox="0 0 900 250" role="img" aria-labelledby="triage-title triage-desc">
      <title id="triage-title">Alert triage flow</title>
      <desc id="triage-desc">
        An alert is checked for plausibility, mapped to a MITRE ATT&CK technique, and given a disposition. False
        positives and benign activity are closed and the rule tuned. True positives are contained and escalated.
      </desc>
      <defs>
        <marker id="arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="arrowhead"></path>
        </marker>
      </defs>
      {
        steps.map((s) => (
          <g>
            <rect x={s.x} y={Y} width={W} height={H} rx="6" class="box" />
            <text x={s.x + W / 2} y={Y + 28} class="t1" text-anchor="middle">
              {s.title}
            </text>
            <text x={s.x + W / 2} y={Y + 49} class="t2" text-anchor="middle">
              {s.sub}
            </text>
          </g>
        ))
      }
      {
        steps.slice(0, -1).map((s) => (
          <line x1={s.x + W} y1={Y + H / 2} x2={s.x + 170 - 2} y2={Y + H / 2} class="flow" marker-end="url(#arrow-t)" />
        ))
      }

      <!-- branches -->
      <path d="M670,110 C700,110 700,50 728,50" class="flow quiet" marker-end="url(#arrow-t)"></path>
      <path d="M670,136 C700,136 700,196 728,196" class="flow hot" marker-end="url(#arrow-t)"></path>

      <rect x="730" y="20" width="160" height="62" rx="6" class="box"></rect>
      <text x="810" y="46" class="t1" text-anchor="middle">Close and tune</text>
      <text x="810" y="66" class="t2" text-anchor="middle">false positive, benign</text>

      <rect x="730" y="166" width="160" height="62" rx="6" class="box hot-box"></rect>
      <text x="810" y="192" class="t1" text-anchor="middle">Contain, escalate</text>
      <text x="810" y="212" class="t2" text-anchor="middle">true positive</text>
    </svg>
  </div>
  <figcaption>Every alert in the demo is worked through these steps. The triage panel shows the reasoning at each one.</figcaption>
</figure>

<style>
  .diagram {
    margin: 1.5rem 0 2rem;
  }
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }
  .box {
    fill: var(--surface-2);
    stroke: var(--rule);
    stroke-width: 1.5;
  }
  .hot-box {
    stroke: var(--sev-critical);
  }
  .t1 {
    fill: var(--text);
    font: 600 15px var(--sans);
  }
  .t2 {
    fill: var(--muted);
    font: 12px var(--mono);
  }
  .flow {
    stroke: var(--signal);
    stroke-width: 1.5;
    fill: none;
  }
  .flow.quiet {
    stroke: var(--muted);
  }
  .flow.hot {
    stroke: var(--sev-critical);
  }
  .arrowhead {
    fill: var(--signal);
  }
  figcaption {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.6rem;
  }
</style>
